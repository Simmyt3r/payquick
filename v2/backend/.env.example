# TLS database connection, configured on Aiven
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_SECRET=CHANGE_TO_A_RANDOM_64_CHARACTER_SECRET
FRONTEND_ORIGINS=http://localhost:5173

# Funding disabled by default
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENTS_ENABLED=false

# Electricity vending (separate gate); sandbox by default, NEVER from client
ELECTRICITY_VENDING_ENABLED=false
METER_VERIFICATION_ENABLED=false
VTPASS_ENV=sandbox
VTPASS_LIVE_ENABLED=false
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
REMOTE_METER_LOADING_ENABLED=false
