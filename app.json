{
  "expo": {
    "name":         "PayQuick",
    "slug":         "payquick-vtu-app",
    "version":      "1.0.0",
    "orientation":  "portrait",
    "icon":         "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image":           "./assets/splash.png",
      "resizeMode":      "contain",
      "backgroundColor": "#5c6bc0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.payquick.app"
    },
    "android": {
      "package":          "ng.payquick.app",
      "versionCode":      1,
      "adaptiveIcon": {
        "foregroundImage":  "./assets/adaptive-icon.png",
        "backgroundColor":  "#5c6bc0"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "PASTE_YOUR_EAS_PROJECT_ID_HERE"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
